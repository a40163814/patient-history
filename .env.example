# ==============================================================================
# AyushIntake - Pre-OPD AI Voice Assistant Environment Configuration
# ==============================================================================

# Server Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite demo, easily switchable to PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./ayush_intake.db
DATABASE_SYNC_URL=sqlite:///./ayush_intake.db

# Security & Tokens
SECRET_KEY=ayush-insecure-development-secret-key-change-in-production-min32bytes
SESSION_EXPIRE_MINUTES=1440
ALLOW_TRANSCRIPT_STORAGE=true
DATA_RETENTION_DAYS=30

# AI / LLM Configuration (Keys & Models must NEVER be hardcoded)
# Gemini Live & Standard API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_SAFETY_MODEL=gemini-3.1-flash-lite

# Bhashini Configuration (Cascaded pipeline for Indian languages)
BHASHINI_USER_ID=mock_bhashini_user_id
BHASHINI_API_KEY=mock_bhashini_api_key
BHASHINI_PIPELINE_ID=mock_bhashini_pipeline_id
BHASHINI_INFERENCE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Safety & Triage Configuration
CRISIS_HELPLINE_NUMBER=14416
CRISIS_HELPLINE_NAME="Kiran / Tele-MANAS Mental Health & National Emergency (112)"
EMERGENCY_AMBULANCE_NUMBER=108

# Storage Paths
UPLOAD_DIR=./uploads
PDF_OUTPUT_DIR=./generated_pdfs
